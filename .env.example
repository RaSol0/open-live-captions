# Copiar este archivo a .env y completar con tus credenciales reales.
# Nunca commitear el .env real al repositorio.

# API key de Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=your_api_key_here

# Puerto del backend
PORT=8000

# Duración de cada chunk de audio en segundos (trade-off latencia vs confiabilidad)
CHUNK_SECONDS=4

# Idioma origen por defecto y lista de idiomas destino, separados por coma
DEFAULT_SOURCE_LANG=en
DEFAULT_TARGET_LANGS=es
